# Zerostack config — TEMPLATE (copy to ~/.config/zerostack/config.toml)
# Replace every $VAR / YOUR-* placeholder with your own values.
# Keys are NEVER in this file — they come from environment variables only.
#   HMS_API_KEY, XINGCHI_API_KEY, TOKENLAB_API_KEY, MOSS_API_KEY,
#   HOWTOFIX_API_KEY, INKLING_API_KEY: your model provider
#   keys, as env vars on the box.
#   VAULT_AGENT_TOKEN: a request-only token for your vault MCP server.
#   YOUR-VAULT-WORKER: your own vault Worker hostname (see below).
# Search: our web.py (TinyFish + Bing cf-search Worker + X/FxEmbed), NOT Exa.
#   enable-exa-mcp = false below removes zerostack's built-in Exa search.

provider = "100milionseek"
model = "deepseek-v4.1-flash-free"
max_tokens = 65536
context_window = 197488

# Zerostack's built-in Exa search is replaced by our web.py search
# (Monid/TinyFish + Bing cf-search Worker + X/FxEmbed). MUST be top-level:
# in TOML, anything after a [table] header belongs to that table.
enable-exa-mcp = false

# --- Custom providers: 6 providers, OpenAI-compatible ---
[custom_providers.100milionseek]
provider_type = "openai"
base_url = "https://100milionseek.top/v1"
api_key_env = "HMS_API_KEY"
model = "deepseek-v4.1-flash-free"

